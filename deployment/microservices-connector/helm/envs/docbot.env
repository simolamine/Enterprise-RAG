#
# Environment variables for the Documentation Inquiry Chatbot (docbot).
# Used by Helm chart to populate ConfigMaps for each microservice.
# Reference: deployment/microservices-connector/helm/values.yaml

# ── Namespace ────────────────────────────────────────────────────────────────
NAMESPACE=docbot

# ── Embedding service ────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_SERVER=tei
EMBEDDING_MODEL_SERVER_ENDPOINT=http://tei-embedding-svc.docbot.svc.cluster.local:80
EMBEDDING_CONNECTOR=langchain

# ── Vector store / Retriever ─────────────────────────────────────────────────
VECTOR_STORE=redis
REDIS_HOST=redis-vector-db.docbot.svc.cluster.local
REDIS_PORT=6379
REDIS_URL=redis://redis-vector-db.docbot.svc.cluster.local:6379
# Isolated index — keeps docbot knowledge base separate from other pipelines
REDIS_INDEX_NAME=docbot-index
RETRIEVER_TOP_K=10

# ── Reranker service ─────────────────────────────────────────────────────────
RERANKING_MODEL_NAME=BAAI/bge-reranker-large
RERANKING_SERVICE_ENDPOINT=http://tei-reranking-svc.docbot.svc.cluster.local:80
RERANKER_TOP_N=5

# ── LLM service ──────────────────────────────────────────────────────────────
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.1
LLM_MODEL_SERVER=tgi
LLM_MODEL_SERVER_ENDPOINT=http://tgi-service-m.docbot.svc.cluster.local:80
LLM_CONNECTOR=langchain

# LLM generation parameters (deterministic, grounded answers)
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.01
LLM_TOP_P=0.95
LLM_TOP_K=10
LLM_REPETITION_PENALTY=1.03
LLM_STREAMING=true

# Documentation-specific system prompt (Phase 4)
DOCBOT_SYSTEM_PROMPT_PATH=/app/prompts/docbot_system_prompt.txt

# ── DataPrep ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
PROCESS_TABLE=true
PROCESS_TABLE_STRATEGY=fast
UPLOAD_PATH=/tmp/docbot_upload

# ── Document Registry ────────────────────────────────────────────────────────
DOC_REGISTRY_HOST=0.0.0.0
DOC_REGISTRY_PORT=6200
DOC_REGISTRY_REDIS_URL=redis://redis-vector-db.docbot.svc.cluster.local:6379
DOC_REGISTRY_REDIS_HASH_PREFIX=docbot:registry

# ── Gateway (mega service) ───────────────────────────────────────────────────
MEGA_SERVICE_HOST_IP=0.0.0.0
MEGA_SERVICE_PORT=8888

# ── Guardrails (Phase 7 — enable when ready) ─────────────────────────────────
# Input scanners
PROMPT_INJECTION_ENABLED=false
BAN_TOPICS_ENABLED=false
# BAN_TOPICS_TOPICS=<comma-separated topic list>
TOKEN_LIMIT_ENABLED=false
TOKEN_LIMIT_LIMIT=512
SECRETS_ENABLED=false

# Output scanners
FACTUAL_CONSISTENCY_ENABLED=false
MALICIOUS_URLS_ENABLED=false
URL_REACHABILITY_ENABLED=false

# ── Observability ─────────────────────────────────────────────────────────────
# Query analytics stream (Phase 9)
QUERY_LOG_STREAM=docbot:query_log
FEEDBACK_STREAM=docbot:feedback_log
