# Doc Registry microservice environment variables
# Override these in the Kubernetes ConfigMap (Helm) or docker-compose env

DOC_REGISTRY_HOST=0.0.0.0
DOC_REGISTRY_PORT=6200
DOC_REGISTRY_REDIS_URL=redis://localhost:6379
DOC_REGISTRY_REDIS_HASH_PREFIX=docbot:registry:
FEEDBACK_STREAM=docbot:feedback_log
OPEA_LOGGER_LEVEL=INFO
